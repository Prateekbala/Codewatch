{
  "name": "pr-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub pull request review agent built on LangGraph",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0",
  "bin": {
    "pr-agent": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "node src/cli/index.ts",
    "dev:server": "node src/server/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "smoke:github": "node scripts/fetch-pr.ts",
    "eval": "node evals/cli.ts --config .pr-agent.yaml"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/openai": "^1.6.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "hono": "^4.13.12",
    "js-tiktoken": "^1.0.21",
    "picomatch": "^4.0.7",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "msw": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
